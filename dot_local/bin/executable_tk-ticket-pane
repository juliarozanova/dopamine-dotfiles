#!/usr/bin/env bash
# tk-ticket-pane — interactive Jira ticket pane for the tk zellij layout.
# Shows just the title, description and comments (no metadata table), with:
#   [r] refresh   re-fetch from Jira (also rewrites TICKET.md in the worktree)
#   [c] comment   add a one-line comment to the ticket
#   [w] web       open the ticket in your browser
set -u
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

KEY="${1:?usage: tk-ticket-pane ISSUE-KEY}"
NCOMMENTS=10

note() { printf '\033[33m  %s\033[0m\n' "$1"; }

footer() {
  printf '\n'
  printf '\033[2m────────────────────────────────────────────────────────────\033[0m\n'
  printf '\033[1m[r]\033[0m refresh   \033[1m[c]\033[0m comment   \033[1m[w]\033[0m web\n'
}

render() {
  clear
  local B=$'\033[1m' R=$'\033[0m'
  # Keep only: the title (`# ...`), the Description separator and everything
  # after it (description body + Comments section). jira's --plain view puts
  # metadata rows above the title and a "View this issue on Jira" footer
  # below — drop those.
  jira issue view "$KEY" --comments "$NCOMMENTS" --plain 2>&1 | awk -v b="$B" -v r="$R" '
    /View this issue on Jira:/ { next }
    /^[[:space:]]*#[[:space:]]/ && !title { title=1; print b $0 r; next }
    /-+[[:space:]]*Description[[:space:]]*-+/ { body=1 }
    body { print }
  '
  footer
}

refresh() {
  # keep the worktree's TICKET.md in sync when we re-fetch
  if [ -f "$PWD/TICKET.md" ]; then
    jira issue view "$KEY" --comments "$NCOMMENTS" --plain > "$PWD/TICKET.md" 2>/dev/null || true
  fi
  render
}

add_comment() {
  printf '\n\033[1m> new comment on %s\033[0m (one line; empty to cancel):\n  ' "$KEY"
  IFS= read -r body || body=""
  case "$body" in
    *[![:space:]]*) : ;;                 # has non-whitespace content
    *) note "cancelled"; return ;;
  esac
  if jira issue comment add "$KEY" "$body" --no-input >/dev/null 2>&1; then
    note "comment added"
  else
    note "failed to add comment"
  fi
}

render
while true; do
  IFS= read -rsn1 c || exit 0
  case "$c" in
    r|R) refresh ;;
    c|C) add_comment; render ;;
    w|W) jira open "$KEY" >/dev/null 2>&1 & ;;
  esac
done
