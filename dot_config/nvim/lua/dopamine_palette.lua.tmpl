-- generated by chezmoi from .chezmoidata/palette.toml — edit that, not this
--
-- Passed to the dopamine colorscheme as its `palette` option (see
-- lua/plugins/colorscheme.lua), which merges these over the colours the plugin
-- ships. That makes palette.toml authoritative for nvim's highlight groups, the
-- same way it already is for WezTerm and zellij.
--
-- Terminal-only `term_*` tints are omitted — they exist for WezTerm's ANSI
-- slots and have no meaning as nvim highlight colours.
return {
{{- range $variant, $p := .palette }}
  {{ $variant }} = {
  {{- range $key, $value := $.shared }}
    {{ $key }} = "{{ $value }}",
  {{- end }}
  {{- range $key, $value := $p }}
  {{- if not (hasPrefix "term_" $key) }}
    {{ $key }} = "{{ $value }}",
  {{- end }}
  {{- end }}
  },
{{- end }}
}
