-- generated by chezmoi — edit dot_config/nvim/lua/plugins/colorscheme.lua.tmpl
--
-- The colorscheme lives in its own repo. Prefer a local dev checkout if you
-- have one (edits show up on restart, no reinstall); otherwise use the clone
-- chezmoi vendors via .chezmoiexternal.toml, so a fresh machine — or WSL, where
-- ~/Dashboard/Code may not exist — still gets the theme.
local dev = vim.fn.expand("~/Dashboard/Code/dopamine-light")
local vendored = vim.fn.expand("~/.local/share/dopamine-light")
local scheme_dir = vim.fn.isdirectory(dev) == 1 and dev or vendored

return {
  {
    "juliarozanova/dopamine-light",
    dir = scheme_dir,
    lazy = false,
    priority = 1000,
    config = function()
      -- Colours come from dopamine-dotfiles' .chezmoidata/palette.toml, written
      -- out by `chezmoi apply` as lua/dopamine_palette.lua. Fall back to the
      -- plugin's own built-in palette if that file isn't there yet (fresh
      -- machine, or nvim config used without chezmoi).
      local ok, palette = pcall(require, "dopamine_palette")

      require("dopamine").setup({
        -- WezTerm only blends cells with no explicit background, so the
        -- colorscheme has to drop its own bg for window_background_opacity to
        -- reach nvim. See the transparency note in wezterm.lua.
        transparent = true,
        palette = ok and palette or nil,
      })
    end,
  },

  {
    "LazyVim/LazyVim",
    opts = {
      -- Startup variant from [theme] variant in palette.toml. On macOS the
      -- autocmd in lua/config/autocmds.lua then tracks the system appearance
      -- live; elsewhere there's no appearance API, so this is what sticks.
      colorscheme = "dopamine-{{ .theme.variant }}",
    },
  },
}
