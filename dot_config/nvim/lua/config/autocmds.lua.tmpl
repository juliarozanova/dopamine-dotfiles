{{ if eq .chezmoi.os "darwin" -}}
-- Follow the macOS system appearance for the dopamine colorscheme. Neovim gets
-- no OS-level dark-mode event, so check on focus and on a slow timer.
--
-- The check runs asynchronously: `vim.fn.system` blocks the editor for the
-- lifetime of the child process, which is a stutter you'd otherwise pay every
-- few seconds forever. FocusGained is what makes it feel instant — you almost
-- always toggle the appearance in another app and come back — and the timer is
-- just the backstop for when focus never changes.
local dopamine_group = vim.api.nvim_create_augroup("dopamine_dark_mode", { clear = true })

local function use(wants_dark)
  local target = wants_dark and "dopamine-dark" or "dopamine-light"
  if vim.g.colors_name ~= target then
    vim.cmd.colorscheme(target)
  end
end

-- `defaults read -g AppleInterfaceStyle` prints "Dark" in dark mode and exits
-- non-zero in light mode (the key is simply absent).
local function check()
  local cmd = { "defaults", "read", "-g", "AppleInterfaceStyle" }
  if vim.system then
    vim.system(cmd, { text = true }, function(res)
      vim.schedule(function()
        use(res.code == 0 and res.stdout:find("Dark") ~= nil)
      end)
    end)
  else
    local ok, out = pcall(vim.fn.system, cmd)
    use(ok and out:find("Dark") ~= nil)
  end
end

vim.api.nvim_create_autocmd({ "FocusGained", "VimEnter" }, {
  group = dopamine_group,
  callback = check,
})

local timer = (vim.uv or vim.loop).new_timer()
timer:start(5000, 5000, vim.schedule_wrap(check))
{{- else -}}
-- No dopamine appearance watcher here: {{ .chezmoi.os }} exposes no equivalent of
-- macOS's AppleInterfaceStyle, and polling something that will never change is
-- just a wasted process. The colorscheme is pinned to `dopamine-{{ .theme.variant }}`
-- by the LazyVim opt in lua/plugins/colorscheme.lua — to switch, set
-- [theme] variant in .chezmoidata/palette.toml and re-run `chezmoi apply`.
{{- end }}
