// ticket layout template — rendered twice:
//   1. chezmoi apply bakes in your home dir  → ~/.config/zellij/templates/ticket.kdl.tpl
//   2. tk substitutes ${TICKET} and ${WORKTREE} at runtime (envsubst)
//
// Chrome is stock zellij: the built-in tab-bar (top) and status-bar keybind
// ribbon (bottom), both coloured by the dopamine component theme. Pane frames
// (config: pane_frames true) draw the outline around each pane.
layout {
    default_tab_template {
        // built-in tab strip
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        // built-in keybind ribbon
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // hide_floating_panes: the checklist below exists from session start but
    // stays out of the way until Alt-t asks for it.
    tab name="${TICKET}" cwd="${WORKTREE}" focus=true hide_floating_panes=true {
        pane split_direction="vertical" {
            // ── main stage: nvim + lazygit stacked together ─────────
            pane size="62%" stacked=true {
                pane name="nvim" command="nvim" focus=true expanded=true
                pane name="⎇ lazygit" command="lazygit"
            }
            // ── the stack: expand what you need, rest fold to titles ─
            pane size="38%" stacked=true {
                pane name="✳ claude" command="bash" expanded=true {
                    args "-lc" "claude --continue 2>/dev/null || claude"
                }
                pane name="◫ ticket" command="tk" {
                    args "view" "${TICKET}"
                }
                pane name="❯ shell"
            }
        }

        // The checklist, ready for Alt-t. Declared here rather than spawned on
        // the keypress: zellij's Run action opens a *new* pane every time it
        // fires, so a keybinding that ran `tk todo` stacked another copy on
        // every press until the floating layer was unusable.
        //
        // The `toggle-floating-panes` before `exec` is not a flourish — zellij
        // focuses a layout-declared floating pane on tab creation and drops the
        // tab's hide_floating_panes, and neither focus=true on a tiled pane nor
        // focus=false here changes that. So the pane hides itself the moment it
        // starts, then becomes the checklist. Net effect: nvim has focus, and
        // tk-tui is already running behind the curtain when you first press
        // Alt-t.
        floating_panes {
            pane name="☑ todo" command="bash" x="15%" y="7%" width="70%" height="85%" {
                args "-lc" "zellij action toggle-floating-panes; exec tk todo"
            }
        }
    }
}
