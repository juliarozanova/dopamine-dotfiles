// ticket layout template — rendered twice:
//   1. chezmoi apply bakes in your home dir  → ~/.config/zellij/templates/ticket.kdl.tpl
//   2. tk substitutes ${TICKET} and ${WORKTREE} at runtime (envsubst)
//
// Chrome is stock zellij: the built-in tab-bar (top) and status-bar keybind
// ribbon (bottom), both coloured by the dopamine component theme. Pane frames
// (config: pane_frames true) draw the outline around each pane.
layout {
    default_tab_template {
        // built-in tab strip
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        // built-in keybind ribbon
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="${TICKET}" cwd="${WORKTREE}" focus=true {
        pane split_direction="vertical" {
            // ── main stage: nvim + lazygit stacked together ─────────
            pane size="62%" stacked=true {
                pane name="nvim" command="nvim" expanded=true
                pane name="⎇ lazygit" command="lazygit"
            }
            // ── the stack: expand what you need, rest fold to titles ─
            pane size="38%" stacked=true {
                pane name="✳ claude" command="bash" expanded=true {
                    args "-lc" "claude --continue 2>/dev/null || claude"
                }
                pane name="◫ ticket" command="tk" {
                    args "view" "${TICKET}"
                }
                pane name="❯ shell"
            }
        }
    }
}
