// dash — home base. Plain `zellij` lands here (default_layout).
// Left stack: PRs + sprint. Right stack: knowledge inbox + files + shell.
//
// Chrome is stock zellij: the built-in tab-bar (top) and status-bar keybind
// ribbon (bottom), both coloured by the dopamine component theme. Pane frames
// (config: pane_frames true) draw the outline around each pane.
layout {
    default_tab_template {
        // built-in tab strip
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        // built-in keybind ribbon
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="dash" cwd="{{ .chezmoi.homeDir }}/Dashboard" focus=true {
        pane split_direction="vertical" {
            pane size="55%" stacked=true {
                pane name="⇅ pull requests" command="gh" expanded=true {
                    args "dash"
                }
                pane name="◷ my issues" command="bash" {
                    // Team-managed (next-gen) projects don't list sprints via
                    // `jira sprint list`, so lead with your open assigned issues
                    // (always useful) and only try the sprint view as a bonus.
                    args "-lc" "[ -f ~/.config/jira-board/env ] && . ~/.config/jira-board/env; { echo '── my open issues ──'; jira issue list -q 'assignee = currentUser() AND statusCategory != Done' --plain --columns key,status,summary 2>&1; echo; echo '── current sprint (if any) ──'; jira sprint list --current --plain 2>&1; } | less -R"
                }
            }
            pane stacked=true {
                pane name="⚑ hdl inbox" command="nvim" expanded=true {
                    args "Knowledge/hdl/inbox.md"
                }
                pane name="🗀 files" command="yazi"
                pane name="❯ shell"
            }
        }
    }
}
