// dash — home base. Plain `zellij` lands here (default_layout).
// Left stack: PRs + my issues. Right stack: todo + files + shell.
//
// Chrome is stock zellij: the built-in tab-bar (top) and status-bar keybind
// ribbon (bottom), both coloured by the dopamine component theme. Pane frames
// (config: pane_frames true) draw the outline around each pane.
layout {
    default_tab_template {
        // built-in tab strip
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        // built-in keybind ribbon
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="dash" cwd="{{ .chezmoi.homeDir }}/Dashboard" focus=true {
        pane split_direction="vertical" {
            pane size="55%" stacked=true {
                pane name="⇅ pull requests" command="gh" expanded=true {
                    args "dash"
                }
                pane name="◷ my issues" command="bash" {
                    // Team-managed (next-gen) projects don't list sprints via
                    // `jira sprint list`, so lead with your open assigned issues
                    // (always useful) and only try the sprint view as a bonus.
                    //
                    // Section headers are bold + ANSI cyan, which WezTerm maps to
                    // the palette's `tag` teal (see wezterm.lua's ANSI slots). Using
                    // an ANSI index rather than a baked-in hex means the headers
                    // follow the terminal into light mode for free, the way stock
                    // zellij chrome does. `tput` keeps it terminfo-correct, and
                    // emits nothing when TERM is dumb.
                    args "-lc" "[ -f ~/.config/jira-board/env ] && . ~/.config/jira-board/env; b=$(tput bold)$(tput setaf 6); r=$(tput sgr0); { echo ${b}'── my open issues ──'${r}; jira issue list -q 'assignee = currentUser() AND statusCategory != Done' --plain --columns key,status,summary 2>&1; echo; echo ${b}'── current sprint (if any) ──'${r}; jira sprint list --current --plain 2>&1; } | less -R"
                }
            }
            pane stacked=true {
                // Every open ticket's TODO section plus ~/Dashboard/todo.md,
                // editable in place. Alt-t floats the same view from anywhere,
                // including from inside a ticket session.
                pane name="☑ todo" command="tk" expanded=true {
                    args "todo"
                }
                pane name="🗀 files" command="yazi"
                pane name="❯ shell"
            }
        }
    }
}
