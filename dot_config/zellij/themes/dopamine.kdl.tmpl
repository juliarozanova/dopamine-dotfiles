// generated by chezmoi from .chezmoidata/palette.toml — edit that, not this
//
// Full component-based zellij theme. Unlike the legacy fg/bg/red/... palette
// format, these slots drive zellij's real UI chrome — the instruction ribbon
// (zellij:status-bar), tab bar, pane frames, tables and lists — so ribbons +
// tabs render in dopamine colours instead of zellij's defaults.
//
// Every variant is emitted (dopamine-dark / -light / -mirage) plus `dopamine`,
// an alias for whichever [theme] variant palette.toml selects — that's the one
// config.kdl refers to. Zellij can't follow macOS appearance, so switching
// means changing `variant` in palette.toml (or `theme` in config.kdl) and
// re-applying. A literal `0` means "terminal default colour".
{{- define "dopamine_theme_body" }}
        text_unselected {
            base "{{ .fg }}"
            background "{{ .bg }}"
            emphasis_0 "{{ .accent }}"
            emphasis_1 "{{ .tag }}"
            emphasis_2 "{{ .func }}"
            emphasis_3 "{{ .constant }}"
        }
        text_selected {
            base "{{ .fg }}"
            background "{{ .selection_bg }}"
            emphasis_0 "{{ .accent }}"
            emphasis_1 "{{ .tag }}"
            emphasis_2 "{{ .func }}"
            emphasis_3 "{{ .constant }}"
        }
        ribbon_selected {
            base "{{ .func }}"
            background "{{ .panel_bg }}"
            emphasis_0 "{{ .markup }}"
            emphasis_1 "{{ .func }}"
            emphasis_2 "{{ .constant }}"
            emphasis_3 "{{ .tag }}"
        }
        ribbon_unselected {
            // all four emphasis slots the same so the status-bar keybind keys
            // (<g> <p> <t> …) don't zebra between colours — one consistent markup
            base "{{ .ui }}"
            background "{{ .panel_bg }}"
            emphasis_0 "{{ .markup }}"
            emphasis_1 "{{ .markup }}"
            emphasis_2 "{{ .markup }}"
            emphasis_3 "{{ .markup }}"
        }
        table_title {
            base "{{ .func }}"
            background 0
            emphasis_0 "{{ .accent }}"
            emphasis_1 "{{ .tag }}"
            emphasis_2 "{{ .func }}"
            emphasis_3 "{{ .constant }}"
        }
        table_cell_selected {
            base "{{ .fg }}"
            background "{{ .selection_bg }}"
            emphasis_0 "{{ .accent }}"
            emphasis_1 "{{ .tag }}"
            emphasis_2 "{{ .func }}"
            emphasis_3 "{{ .constant }}"
        }
        table_cell_unselected {
            base "{{ .fg }}"
            background "{{ .bg }}"
            emphasis_0 "{{ .accent }}"
            emphasis_1 "{{ .tag }}"
            emphasis_2 "{{ .func }}"
            emphasis_3 "{{ .constant }}"
        }
        list_selected {
            base "{{ .fg }}"
            background "{{ .selection_bg }}"
            emphasis_0 "{{ .accent }}"
            emphasis_1 "{{ .tag }}"
            emphasis_2 "{{ .func }}"
            emphasis_3 "{{ .constant }}"
        }
        list_unselected {
            base "{{ .fg }}"
            background "{{ .bg }}"
            emphasis_0 "{{ .accent }}"
            emphasis_1 "{{ .tag }}"
            emphasis_2 "{{ .func }}"
            emphasis_3 "{{ .constant }}"
        }
        frame_selected {
            base "{{ .func }}"
            background 0
            emphasis_0 "{{ .accent }}"
            emphasis_1 "{{ .tag }}"
            emphasis_2 "{{ .constant }}"
            emphasis_3 0
        }
        frame_highlight {
            base "{{ .accent }}"
            background 0
            emphasis_0 "{{ .constant }}"
            emphasis_1 "{{ .accent }}"
            emphasis_2 "{{ .accent }}"
            emphasis_3 "{{ .accent }}"
        }
        exit_code_success {
            base "{{ .func }}"
            background 0
            emphasis_0 "{{ .tag }}"
            emphasis_1 "{{ .bg }}"
            emphasis_2 "{{ .constant }}"
            emphasis_3 "{{ .tag }}"
        }
        exit_code_error {
            base "{{ .markup }}"
            background 0
            emphasis_0 "{{ .special }}"
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 "{{ .constant }}"
            player_2 "{{ .regexp }}"
            player_3 0
            player_4 "{{ .special }}"
            player_5 "{{ .tag }}"
            player_6 0
            player_7 "{{ .markup }}"
            player_8 0
            player_9 0
            player_10 0
        }
{{- end }}
themes {
{{- range $variant, $p := .palette }}
    dopamine-{{ $variant }} {
        {{- template "dopamine_theme_body" $p }}
    }
{{- end }}
    // active variant — [theme] variant = "{{ .theme.variant }}"
    dopamine {
        {{- template "dopamine_theme_body" (index .palette .theme.variant) }}
    }
}
