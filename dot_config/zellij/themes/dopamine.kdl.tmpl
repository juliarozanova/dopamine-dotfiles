// generated by chezmoi from .chezmoidata/palette.toml — edit that, not this
//
// Full component-based zellij theme (ported from ~/dotfiles/zellij, the "old"
// dopamine theme). Unlike the legacy fg/bg/red/... palette format, these slots
// drive zellij's real UI chrome — the instruction ribbon (zellij:status-bar),
// tab bar, pane frames, tables and lists — so ribbons + tabs render in dopamine
// colours instead of zellij's defaults.
//
// Neutrals that have no palette slot (the selection gray, the second player
// color, and the literal `0` = terminal default) are kept as-is from the old
// theme. Everything else maps to a palette variable so colour stays sourced in
// one place: .chezmoidata/palette.toml.
themes {
    dopamine {
        text_unselected {
            base "{{ .palette.fg }}"
            background "{{ .palette.bg }}"
            emphasis_0 "{{ .palette.mauve }}"
            emphasis_1 "{{ .palette.teal }}"
            emphasis_2 "{{ .palette.green }}"
            emphasis_3 "{{ .palette.pink }}"
        }
        text_selected {
            base "{{ .palette.fg }}"
            background "#515F6E"
            emphasis_0 "{{ .palette.mauve }}"
            emphasis_1 "{{ .palette.teal }}"
            emphasis_2 "{{ .palette.green }}"
            emphasis_3 "{{ .palette.pink }}"
        }
        ribbon_selected {
            base "{{ .palette.green }}"
            background "{{ .palette.surface }}"
            emphasis_0 "{{ .palette.peach }}"
            emphasis_1 "{{ .palette.green }}"
            emphasis_2 "{{ .palette.pink }}"
            emphasis_3 "{{ .palette.teal }}"
        }
        ribbon_unselected {
            // all four emphasis slots the same so the status-bar keybind keys
            // (<g> <p> <t> …) don't zebra between colours — one consistent peach
            base "{{ .palette.overlay }}"
            background "{{ .palette.surface }}"
            emphasis_0 "{{ .palette.peach }}"
            emphasis_1 "{{ .palette.peach }}"
            emphasis_2 "{{ .palette.peach }}"
            emphasis_3 "{{ .palette.peach }}"
        }
        table_title {
            base "{{ .palette.green }}"
            background 0
            emphasis_0 "{{ .palette.mauve }}"
            emphasis_1 "{{ .palette.teal }}"
            emphasis_2 "{{ .palette.green }}"
            emphasis_3 "{{ .palette.pink }}"
        }
        table_cell_selected {
            base "{{ .palette.fg }}"
            background "#515F6E"
            emphasis_0 "{{ .palette.mauve }}"
            emphasis_1 "{{ .palette.teal }}"
            emphasis_2 "{{ .palette.green }}"
            emphasis_3 "{{ .palette.pink }}"
        }
        table_cell_unselected {
            base "{{ .palette.fg }}"
            background "{{ .palette.bg }}"
            emphasis_0 "{{ .palette.mauve }}"
            emphasis_1 "{{ .palette.teal }}"
            emphasis_2 "{{ .palette.green }}"
            emphasis_3 "{{ .palette.pink }}"
        }
        list_selected {
            base "{{ .palette.fg }}"
            background "#515F6E"
            emphasis_0 "{{ .palette.mauve }}"
            emphasis_1 "{{ .palette.teal }}"
            emphasis_2 "{{ .palette.green }}"
            emphasis_3 "{{ .palette.pink }}"
        }
        list_unselected {
            base "{{ .palette.fg }}"
            background "{{ .palette.bg }}"
            emphasis_0 "{{ .palette.mauve }}"
            emphasis_1 "{{ .palette.teal }}"
            emphasis_2 "{{ .palette.green }}"
            emphasis_3 "{{ .palette.pink }}"
        }
        frame_selected {
            base "{{ .palette.green }}"
            background 0
            emphasis_0 "{{ .palette.mauve }}"
            emphasis_1 "{{ .palette.teal }}"
            emphasis_2 "{{ .palette.pink }}"
            emphasis_3 0
        }
        frame_highlight {
            base "{{ .palette.mauve }}"
            background 0
            emphasis_0 "{{ .palette.pink }}"
            emphasis_1 "{{ .palette.mauve }}"
            emphasis_2 "{{ .palette.mauve }}"
            emphasis_3 "{{ .palette.mauve }}"
        }
        exit_code_success {
            base "{{ .palette.green }}"
            background 0
            emphasis_0 "{{ .palette.teal }}"
            emphasis_1 "{{ .palette.bg }}"
            emphasis_2 "{{ .palette.pink }}"
            emphasis_3 "{{ .palette.teal }}"
        }
        exit_code_error {
            base "{{ .palette.peach }}"
            background 0
            emphasis_0 "{{ .palette.yellow }}"
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 "{{ .palette.pink }}"
            player_2 "#4CCFA1"
            player_3 0
            player_4 "{{ .palette.yellow }}"
            player_5 "{{ .palette.teal }}"
            player_6 0
            player_7 "{{ .palette.peach }}"
            player_8 0
            player_9 0
            player_10 0
        }
    }
}
