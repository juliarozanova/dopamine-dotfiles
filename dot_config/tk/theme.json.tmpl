{{/*
  generated by chezmoi from .chezmoidata/palette.toml — edit that, not this.
  Read by tk-tui (tk-tui/src/theme.rs) so the ticket pane uses the same palette
  as Neovim, WezTerm and zellij. `active` mirrors [theme] variant; tk-tui
  prefers the macOS appearance over it, and $TK_THEME_VARIANT over both.
  term_* tints are dropped — they're WezTerm ANSI slots, not UI roles.
*/ -}}
{{- $variants := keys .palette | sortAlpha -}}
{{- $last := sub (len $variants) 1 -}}
{
  "_generated": "chezmoi, from .chezmoidata/palette.toml — do not edit",
  "active": "{{ .theme.variant }}",
  "variants": {
{{- range $i, $variant := $variants }}
  {{- $p := index $.palette $variant }}
  {{- $roles := list }}
  {{- range $key, $value := $p }}
    {{- if not (hasPrefix "term_" $key) }}{{ $roles = append $roles (printf "%q: %q" $key $value) }}{{ end }}
  {{- end }}
    "{{ $variant }}": {
      {{ join ",\n      " $roles }}
    }{{ if ne $i $last }},{{ end }}
{{- end }}
  }
}
