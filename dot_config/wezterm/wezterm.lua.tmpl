{{- $dark := .palette.dark -}}
{{- $light := .palette.light -}}
-- generated by chezmoi from .chezmoidata/palette.toml — edit that, not this
--
-- Dopamine colour schemes, sharing one palette with the dopamine Neovim
-- colorscheme and the zellij theme. ANSI slots are mapped from the theme's
-- syntax roles so editor, shell and multiplexer all read from the same
-- colours:
--   black=panel_shadow/fg, red=error, green=func, yellow=special,
--   blue=keyword (the palette runs blue-less, so keyword's slate-blue stands
--   in), magenta=constant, cyan=tag, white=ui/gutter.
-- The handful of ANSI slots with no semantic equivalent live in palette.toml
-- as `term_*` tints.
local wezterm = require("wezterm")
local config = wezterm.config_builder and wezterm.config_builder() or {}

local scheme_dark = {
	foreground = "{{ $dark.fg }}",
	background = "{{ $dark.bg }}",
	cursor_bg = "{{ $dark.accent }}",
	cursor_border = "{{ $dark.accent }}",
	cursor_fg = "{{ $dark.bg }}",
	selection_bg = "{{ $dark.selection_bg }}",
	selection_fg = "{{ $dark.fg }}",

	ansi = {
		"{{ $dark.panel_shadow }}", -- black
		"{{ $dark.error }}", -- red
		"{{ $dark.func }}", -- green
		"{{ $dark.special }}", -- yellow
		"{{ $dark.keyword }}", -- blue
		"{{ $dark.constant }}", -- magenta
		"{{ $dark.tag }}", -- cyan
		"{{ $dark.ui }}", -- white
	},
	brights = {
		"{{ $dark.comment }}", -- bright black
		"{{ $dark.vcs_removed }}", -- bright red
		"{{ $dark.string }}", -- bright green
		"{{ $dark.warning }}", -- bright yellow
		"{{ $dark.term_bright_blue }}", -- bright blue
		"{{ $dark.term_bright_magenta }}", -- bright magenta
		"{{ $dark.regexp }}", -- bright cyan
		"{{ $dark.fg }}", -- bright white
	},

	tab_bar = {
		background = "{{ $dark.line }}",
		active_tab = {
			bg_color = "{{ $dark.bg }}",
			fg_color = "{{ $dark.fg }}",
		},
		inactive_tab = {
			bg_color = "{{ $dark.line }}",
			fg_color = "{{ $dark.ui }}",
		},
		inactive_tab_hover = {
			bg_color = "{{ $dark.panel_bg }}",
			fg_color = "{{ $dark.fg }}",
		},
		new_tab = {
			bg_color = "{{ $dark.line }}",
			fg_color = "{{ $dark.ui }}",
		},
	},
}

local scheme_light = {
	foreground = "{{ $light.fg }}",
	background = "{{ $light.bg }}",
	cursor_bg = "{{ $light.accent }}",
	cursor_border = "{{ $light.accent }}",
	cursor_fg = "{{ $light.bg }}",
	selection_bg = "{{ $light.selection_bg }}",
	selection_fg = "{{ $light.fg }}",

	ansi = {
		"{{ $light.fg }}", -- black
		"{{ $light.error }}", -- red
		"{{ $light.func }}", -- green
		"{{ $light.special }}", -- yellow
		"{{ $light.term_blue }}", -- blue
		"{{ $light.constant }}", -- magenta
		"{{ $light.tag }}", -- cyan
		"{{ $light.gutter_normal }}", -- white
	},
	brights = {
		"{{ $light.comment }}", -- bright black
		"{{ $light.term_bright_red }}", -- bright red
		"{{ $light.string }}", -- bright green
		"{{ $light.term_bright_yellow }}", -- bright yellow
		"{{ $light.term_bright_blue }}", -- bright blue
		"{{ $light.term_bright_magenta }}", -- bright magenta
		"{{ $light.regexp }}", -- bright cyan
		"{{ .shared.white }}", -- bright white
	},

	tab_bar = {
		background = "{{ $light.panel_border }}",
		active_tab = {
			bg_color = "{{ $light.bg }}",
			fg_color = "{{ $light.fg }}",
		},
		inactive_tab = {
			bg_color = "{{ $light.panel_border }}",
			fg_color = "{{ $light.ui }}",
		},
		inactive_tab_hover = {
			bg_color = "{{ $light.line }}",
			fg_color = "{{ $light.fg }}",
		},
		new_tab = {
			bg_color = "{{ $light.panel_border }}",
			fg_color = "{{ $light.ui }}",
		},
	},
}

config.color_schemes = {
	["Dopamine Dark"] = scheme_dark,
	["Dopamine Light"] = scheme_light,
}

-- Follow macOS system appearance. WezTerm re-evaluates this on startup and
-- whenever the OS appearance changes, so switching System Settings > Appearance
-- flips the terminal colors live.
local function scheme_for_appearance(appearance)
	if appearance:find("Dark") then
		return "Dopamine Dark"
	else
		return "Dopamine Light"
	end
end

wezterm.on("window-config-reloaded", function(window, pane)
	local overrides = window:get_config_overrides() or {}
	local scheme = scheme_for_appearance(window:get_appearance())
	if overrides.color_scheme ~= scheme then
		overrides.color_scheme = scheme
		window:set_config_overrides(overrides)
	end
end)

config.color_scheme = scheme_for_appearance(wezterm.gui and wezterm.gui.get_appearance() or "Dark")

config.enable_tab_bar = false

-- Transparency. `window_background_opacity` only blends cells that carry no
-- explicit background colour. WezTerm does not treat an explicit background
-- that happens to equal the scheme's own background as "unset", so a TUI that
-- paints its backdrop (Neovim's `Normal`) renders as an opaque rectangle no
-- matter what this is set to — see wezterm#1425. Lowering
-- `text_background_opacity` would fix nvim but also wash out every deliberate
-- background elsewhere (lazygit, btop, `ls` colours), so it stays opaque and
-- nvim opts out on its side instead: the dopamine colorscheme's `transparent`
-- option clears the bg on Normal/NormalFloat/SignColumn/etc.
config.window_background_opacity = 0.8
config.text_background_opacity = 1.0
config.macos_window_background_blur = 10

return config
