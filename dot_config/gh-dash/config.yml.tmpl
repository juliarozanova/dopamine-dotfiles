{{- $p := index .palette .theme.variant -}}
# generated by chezmoi from .chezmoidata/palette.toml — edit that, not this
#
# gh-dash is the dash layout's "⇅ pull requests" pane, so its colours come from
# the same palette as Neovim / WezTerm / zellij. gh-dash has no light/dark
# switching of its own, so it follows [theme] variant (currently: {{ .theme.variant }}).
prSections:
    - title: My Pull Requests
      filters: is:open author:@me
    - title: Needs My Review
      filters: is:open review-requested:@me
    - title: Involved
      filters: is:open involves:@me -author:@me
issuesSections:
    - title: My Issues
      filters: is:open author:@me
    - title: Assigned
      filters: is:open assignee:@me
    - title: Involved
      filters: is:open involves:@me -author:@me
notificationsSections:
    - title: All
      filters: ""
    - title: Created
      filters: reason:author
    - title: Participating
      filters: reason:participating
    - title: Mentioned
      filters: reason:mention
    - title: Review Requested
      filters: reason:review-requested
    - title: Assigned
      filters: reason:assign
    - title: Subscribed
      filters: reason:subscribed
    - title: Team Mentioned
      filters: reason:team-mention
repo:
    branchesRefetchIntervalSeconds: 30
    prsRefetchIntervalSeconds: 60
defaults:
    preview:
        open: true
        width: 0.45
        height: 0.6
        position: auto
    prsLimit: 20
    prApproveComment: LGTM
    issuesLimit: 20
    notificationsLimit: 20
    view: prs
    layout:
        prs:
            updatedAt:
                width: 5
            createdAt:
                width: 5
            repo:
                width: 20
            author:
                width: 15
            authorIcon:
                hidden: false
            labels:
                width: 22
                hidden: true
            assignees:
                width: 20
                hidden: true
            base:
                width: 15
                hidden: true
            lines:
                width: 15
        issues:
            updatedAt:
                width: 5
            createdAt:
                width: 5
            repo:
                width: 15
            creator:
                width: 10
            creatorIcon:
                hidden: false
            assignees:
                width: 20
                hidden: true
    refetchIntervalMinutes: 30
keybindings: {}
repoPaths: {}
theme:
    colors:
        # primary = rows and titles, secondary = section headers and counts,
        # faint = the quiet columns (timestamps), inverted = text sitting on an
        # accent background.
        text:
            primary: "{{ $p.fg }}"
            secondary: "{{ $p.ui }}"
            inverted: "{{ $p.bg }}"
            faint: "{{ $p.comment }}"
            warning: "{{ $p.warning }}"   # draft / conflicting
            success: "{{ $p.vcs_added }}"   # mergeable / checks passed
        background:
            # cursor row — the slot zellij's list_selected uses, so a focused row
            # reads the same in both panes
            selected: "{{ $p.selection_bg }}"
        border:
            primary: "{{ $p.accent }}"   # focused pane — matches zellij frame_highlight
            secondary: "{{ $p.selection_border }}"
            faint: "{{ $p.guide_normal }}"     # table separators
    ui:
        sectionsShowCount: true
        table:
            showSeparator: true
            compact: false
pager:
    diff: ""
confirmQuit: false
showAuthorIcons: true
smartFilteringAtLaunch: true
includeReadNotifications: true
